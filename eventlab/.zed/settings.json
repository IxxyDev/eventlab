{
  "tab_size": 2,
  "hard_tabs": false,
  "preferred_line_length": 80,
  "wrap_guides": [80],
  "languages": {
    "Svelte": {
      "language_servers": ["biome", "..."],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    }
  }
}
