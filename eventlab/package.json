{
  "name": "eventlab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^26"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint:deps": "svelte-kit sync && depcruise src"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "playwright": "^1.64.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "allowScripts": {
    "fsevents": false
  }
}
