{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "src/**",
      "e2e/**",
      "*.json",
      "*.ts",
      "*.js",
      ".zed/**",
      ".vscode/**"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useImportExtensions": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "#lib/**",
                  "!#lib/**/*.ts",
                  "!#lib/**/*.svelte",
                  "!#lib/**/*.css",
                  "!#lib/**/*.svg"
                ],
                "message": "Через #lib импортируйте файл с настоящим расширением: .ts, .svelte, .css или .svg."
              }
            ]
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  }
}
